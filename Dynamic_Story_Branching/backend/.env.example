# Server Port Configuration
PORT=5000

# MongoDB Connection String
# Replace with your MongoDB Atlas connection string or local MongoDB instance: mongodb://localhost:27017/dynamic_stories
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dynamic_stories?retryWrites=true&w=majority

# Secret key used for signing JSON Web Tokens (JWT)
SECRET_KEY=PASSKEY
